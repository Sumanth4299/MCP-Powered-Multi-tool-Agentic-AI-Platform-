```env
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:sumanth@localhost:5432/productivity_agent

# JWT Authentication
SECRET_KEY=super-secret-key-change-this-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Cryptography
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
ENCRYPTION_KEY=t_h-XyZ1234567890abcdefghijklmnopqrstuvwxyz=

# Google OAuth2 (Optional for basic task testing, required for Google Calendar)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
```
